# Copy this file to .env and fill in the values for your local environment.
# This project auto-loads .env via python-dotenv in Django settings.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Karachi

# Groq / LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
DOCTOR_GROQ_MODEL=

# Speech-to-text
STT_MODEL=base.en
STT_LANGUAGE=en

# Local TTS voice model
PIPER_VOICE_PATH=models/piper/en_US-lessac-medium.onnx

# Reminder scheduling and call behavior
REMINDER_LEAD_MINUTES=30
REMINDER_REPEAT_MINUTES=5
SNOOZE_MINUTES=15
SNOOZE_MIN_BUFFER_MINUTES=1
REMINDER_MAX_ATTEMPTS=6
REMINDER_MIN_LEAD_TO_REMIND_MINUTES=2
DOCTOR_PRESENCE_TTL_SECONDS=30
VOICE_INCLUDE_PURPOSE=true
CALL_AUTO_HANGUP_AFTER_TERMINAL=true

# Google Calendar OAuth credentials are loaded from client_secret_*.json or credentials.json
# in the project root, and the app writes the refreshed token to token.json.
